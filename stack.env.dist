# Database passwords: set strong values before the first start, e.g. with
# `openssl rand -base64 24`.  The stack refuses to start while any of them
# is empty.  MYSQL_PASSWORD and DB_PASS must be the same.  They are only
# used when the database is first created; changing them later here doesn't
# change the passwords in MariaDB.  Write a literal $ as $$ (compose expands
# $ in this file).
MYSQL_DATABASE=mprov
MYSQL_ROOT_PASSWORD=
MYSQL_USER=mprov
MYSQL_PASSWORD=
DB_ENGINE=django.db.backends.mysql
DB_NAME=mprov
DB_USER=mprov
DB_PASS=
DB_HOST=db
DB_PORT=3306

# Set Your Timezone.
TZ=America/New_York

# The mPCC's time zone.  It reads TIME_ZONE, not TZ, so without this an mPCC
# before 0.6.3 runs in UTC however TZ is set (mprov-ng/mprov_control_center#456);
# from 0.6.3 it falls back to TZ on its own.  This takes its value from TZ
# above, so the zone is only set in one place -- edit TZ, not this line.
#
# Set TZ to a zone NAME, such as America/New_York.  The POSIX forms the TZ
# variable also allows -- ":America/New_York", "EST5EDT,M3.2.0,M11.1.0" --
# are not names Django accepts.  From mPCC 0.6.3 one of those only costs you
# a warning and UTC, but an older mPCC takes TIME_ZONE as given and won't
# start with it.
TIME_ZONE=${TZ:-UTC}

# the hostname you want to give to the mPCC container.
MPROV_MPCC_HOSTNAME=mprov-mpcc

# A comma separated list of IPs that will be used in your web browser to access the mPCC 
# This should not include 127.0.0.1

MPROV_MPCC_IPs=<Internal Ip address>,<External Ip address>,<Other Network address>

# the fqdn of the mPCC.  This is added to ALLOWED_HOSTS
MPROV_DOMAINNAME=<changemenow.com>

# the hostname of the jobserver
MPROV_JOBSERVER_HOSTNAME=mprov-jobserver1

# the URL of the mPCC relative to the jobserver.
MPROV_URL=http://<IP of Host Server>

# apikey will get autogenerated in full stack mode, this WILL be over-written if mpcc is run along
# side the jobserver.
MPROV_APIKEY=<changemenow>

# Uncomment to pin the mPCC superuser password at first start (mprov-ng/mprov_control_center#337).
#MPROV_SUPERUSER_PASSWORD=

# Uncomment to fail a stale job server's RUNNING jobs after this many minutes of no heartbeat;
# 0 turns this off (mprov-ng/mprov_control_center#254).
#JOBSERVER_FAIL_JOBS_AFTER_MINUTES=10

# Uncomment to delete a job server after this many days of no heartbeat; 0 (the default) means
# never delete it (mprov-ng/mprov_control_center#254).
#JOBSERVER_DELETE_AFTER_DAYS=0

# Uncomment to change where `manage.py mprov_backup` writes by default
# (mprov-ng/mprov_control_center#457).  The default, /var/lib/mprov/backups, is
# the mpcc-backups volume in docker-compose.yml, so backups survive an upgrade.
# Pointing this somewhere else without also mounting that path puts backups
# back inside the container, where recreating it throws them away.  Never set
# it under media/ or static/, which the web server serves.
#MPROV_BACKUP_DIR=/var/lib/mprov/backups

# the address/hostname of the jobserver.
MPROV_ADDRESS=<IP of Host Server>

# the mprov jobserver plugins you want to load
MPROV_MODS=repo-update image-update image-delete mprov-webserver dnsmasq libgenders

# Optional job server settings (needs a job server with mprov-ng/mprov_jobserver#301).
# Uncomment MPROV_CA_BUNDLE when MPROV_URL is https and the mPCC's certificate is
# from a site or self-signed CA.  It is a path inside the job server container;
# /etc/mprov is the mprov-conf volume, so a file put there survives a restart.
#MPROV_CA_BUNDLE=/etc/mprov/mpcc-ca.pem
# Uncomment to change how much the job server logs: error, warning, info (the
# default) or debug.
#MPROV_LOG_LEVEL=info
